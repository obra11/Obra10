  validade       DateTime              @db.Date
  resultado      ResultadoExame?
  clinica        String?
  observacao     String?
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  deletedAt      DateTime?             @map("deleted_at")

  empresa     Empresa     @relation(fields: [empresaId], references: [id])
  funcionario Funcionario @relation(fields: [funcionarioId], references: [id])

  @@index([empresaId, validade])
  @@index([funcionarioId, tipo])
  @@map("exames_funcionario")
}

model AgendaManutencao {
  id            String             @id @default(uuid())
  empresaId     String             @map("empresa_id")
  obraId        String             @map("obra_id")
  ano           Int
  servico       String
  natureza      NaturezaManutencao
  dataPrevista  DateTime           @map("data_prevista") @db.Date
  fornecedorId  String?            @map("fornecedor_id")
  valorPrevisto Decimal            @default(0) @map("valor_previsto") @db.Decimal(14, 2)
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  deletedAt     DateTime?          @map("deleted_at")

  empresa    Empresa           @relation(fields: [empresaId], references: [id])
  obra       Obra              @relation(fields: [obraId], references: [id])
  fornecedor Fornecedor?       @relation(fields: [fornecedorId], references: [id])
  fichas     FichaManutencao[]

  @@index([empresaId, obraId, ano])
  @@index([obraId, dataPrevista])
  @@map("agendas_manutencao")
}

model FichaManutencao {
  id              String                @id @default(uuid())
  empresaId       String                @map("empresa_id")
  obraId          String                @map("obra_id")
  agendaId        String?               @map("agenda_id")
  origem          OrigemFichaManutencao
  tipo            TipoFichaManutencao
  servico         String
  natureza        NaturezaManutencao
  fornecedorId    String?               @map("fornecedor_id")
  profissional    String                @default("")
  dataExecucao    DateTime?             @map("data_execucao") @db.Date
  horaExecucao    String?               @map("hora_execucao")
  descricao       String?
  status          StatusFichaManutencao @default(RASCUNHO)
  responsavelId   String?               @map("responsavel_id")
  motivoDevolucao String?               @map("motivo_devolucao")
  validadaEm      DateTime?             @map("validada_em")
  validadaPorId   String?               @map("validada_por_id")
  criadaPorId     String                @map("criada_por_id")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  deletedAt       DateTime?             @map("deleted_at")

  empresa     Empresa                  @relation(fields: [empresaId], references: [id])
  obra        Obra                     @relation(fields: [obraId], references: [id])
  agenda      AgendaManutencao?        @relation(fields: [agendaId], references: [id])
  fornecedor  Fornecedor?              @relation(fields: [fornecedorId], references: [id])
  responsavel Usuario?                 @relation("FichaManutencaoResponsavel", fields: [responsavelId], references: [id])
  validadaPor Usuario?                 @relation("FichaManutencaoValidador", fields: [validadaPorId], references: [id])
  criadaPor   Usuario                  @relation("FichaManutencaoCriador", fields: [criadaPorId], references: [id])
  despesas    FichaManutencaoDespesa[]

  @@index([empresaId, obraId, status])
  @@index([agendaId])
  @@index([responsavelId])
  @@map("fichas_manutencao")
}

model FichaManutencaoDespesa {
  id            String   @id @default(uuid())
  empresaId     String   @map("empresa_id")
  fichaId       String   @map("ficha_id")
  descricao     String
  quantidade    Decimal  @default(1) @db.Decimal(14, 4)
  unidade       String?
  valorUnitario Decimal  @map("valor_unitario") @db.Decimal(14, 4)
  valorTotal    Decimal  @map("valor_total") @db.Decimal(14, 2)
  insumoId      String?  @map("insumo_id")
  createdAt     DateTime @default(now()) @map("created_at")

  empresa Empresa         @relation(fields: [empresaId], references: [id])
  ficha   FichaManutencao @relation(fields: [fichaId], references: [id], onDelete: Cascade)
  insumo  CatalogoInsumo? @relation(fields: [insumoId], references: [id])

  @@index([fichaId])
  @@index([empresaId])
  @@map("fichas_manutencao_despesas")
}

enum StatusChamadoSuporte {
