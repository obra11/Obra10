  NFCE_CUPOM
  FOTO
  MANUAL
}

enum StatusDocumentoEntrada {
  EXTRAINDO
  EM_CONFERENCIA
  CONFIRMADA
  REJEITADA
  ESTORNADA
}

enum StatusItemEntrada {
  PENDENTE
  VINCULADO
  NOVO
  IGNORADO
}

enum TipoLocalEstoque {
  DEPOSITO_CENTRAL
  ALMOXARIFADO
}

enum TipoMovimentoEstoque {
  ENTRADA
  SAIDA
  TRANSFERENCIA
  ESTORNO
}

enum NaturezaManutencao {
  LIMPEZA
  ESPECIALIDADE
}

enum OrigemFichaManutencao {
  PLANEJADA
  MANUAL
}

enum TipoFichaManutencao {
  PREVENTIVA
  EXECUTIVA
}

enum StatusFichaManutencao {
  RASCUNHO
  ENVIADA
  VALIDADA
  DEVOLVIDA
  CANCELADA
}

model CatalogoInsumo {
  id           String          @id @default(uuid())
  empresaId    String          @map("empresa_id")
  tipo         TipoInsumo
  nome         String
  unidade      String?
  codigo       String?
  observacao   String?
  categoria    CategoriaInsumo @default(OUTRO)
  ean          String?
  codigoBarras String?         @map("codigo_barras")
  ativo        Boolean         @default(true)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  deletedAt    DateTime?       @map("deleted_at")

  empresa            Empresa                 @relation(fields: [empresaId], references: [id])
  aliases            InsumoAlias[]
  itensEntrada       DocumentoEntradaItem[]
  saldos             SaldoEstoque[]
  movimentos         MovimentoEstoque[]
  despesasManutencao FichaManutencaoDespesa[]

  @@index([empresaId, tipo])
  @@index([empresaId, ean])
  @@index([empresaId, codigoBarras])
  @@map("catalogo_insumos")
}

model Fornecedor {
  id           String    @id @default(uuid())
  empresaId    String    @map("empresa_id")
  cnpj         String?
  razaoSocial  String    @map("razao_social")
  nomeFantasia String?   @map("nome_fantasia")
  ie           String?
  telefone     String?
  email        String?
  endereco     String?
  ativo        Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  empresa           Empresa            @relation(fields: [empresaId], references: [id])
  aliases           InsumoAlias[]
  documentos        DocumentoEntrada[]
  agendasManutencao AgendaManutencao[]
  fichasManutencao  FichaManutencao[]

  @@unique([empresaId, cnpj])
  @@index([empresaId])
  @@map("fornecedores")
}

model LocalEstoque {
  id        String           @id @default(uuid())
  empresaId String           @map("empresa_id")
  obraId    String?          @map("obra_id")
  tipo      TipoLocalEstoque
  nome      String
  codigo    String
  ativo     Boolean          @default(true)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  empresa           Empresa            @relation(fields: [empresaId], references: [id])
  obra              Obra?              @relation(fields: [obraId], references: [id])
  saldos            SaldoEstoque[]
  documentos        DocumentoEntrada[]
  movimentosOrigem  MovimentoEstoque[] @relation("MovimentoOrigem")
  movimentosDestino MovimentoEstoque[] @relation("MovimentoDestino")

  @@unique([empresaId, codigo])
  @@index([empresaId, tipo])
  @@map("locais_estoque")
}

model InsumoAlias {
  id                   String   @id @default(uuid())
  empresaId            String   @map("empresa_id")
  insumoId             String   @map("insumo_id")
  fornecedorId         String?  @map("fornecedor_id")
  descricaoOriginal    String   @map("descricao_original")
  descricaoNormalizada String   @map("descricao_normalizada")
  createdAt            DateTime @default(now()) @map("created_at")

  empresa    Empresa        @relation(fields: [empresaId], references: [id])
  insumo     CatalogoInsumo @relation(fields: [insumoId], references: [id])
  fornecedor Fornecedor?    @relation(fields: [fornecedorId], references: [id])

  @@unique([empresaId, descricaoNormalizada])
  @@index([empresaId, insumoId])
  @@map("insumos_alias")
}

model DocumentoEntrada {
  id                 String                 @id @default(uuid())
  empresaId          String                 @map("empresa_id")
  localId            String                 @map("local_id")
  obraId             String?                @map("obra_id")
  tipo               TipoDocumentoEntrada   @default(NFE)
  status             StatusDocumentoEntrada @default(EXTRAINDO)
  numero             String?
  serie              String?
  chaveAcesso        String?                @map("chave_acesso")
  dataEmissao        DateTime?              @map("data_emissao")
  valorTotal         Decimal?               @map("valor_total") @db.Decimal(14, 2)
  fornecedorId       String?                @map("fornecedor_id")
  fornecedorCnpj     String?                @map("fornecedor_cnpj")
  fornecedorRazao    String?                @map("fornecedor_razao")
  fornecedorIe       String?                @map("fornecedor_ie")
  fornecedorTelefone String?                @map("fornecedor_telefone")
  fornecedorEmail    String?                @map("fornecedor_email")
  recebedorId        String                 @map("recebedor_id")
  criadorId          String                 @map("criador_id")
  imagemUrl          String?                @map("imagem_url")
  imagemMime         String?                @map("imagem_mime")
  imagemNome         String?                @map("imagem_nome")
  observacao         String?                @db.Text
  observacaoExtracao String?                @map("observacao_extracao")
  rejeitadoMotivo    String?                @map("rejeitado_motivo")
  confirmadoEm       DateTime?              @map("confirmado_em")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  empresa    Empresa                @relation(fields: [empresaId], references: [id])
  local      LocalEstoque           @relation(fields: [localId], references: [id])
  fornecedor Fornecedor?            @relation(fields: [fornecedorId], references: [id])
  recebedor  Usuario                @relation("DocumentoEntradaRecebedor", fields: [recebedorId], references: [id])
  criador    Usuario                @relation("DocumentoEntradaCriador", fields: [criadorId], references: [id])
  itens      DocumentoEntradaItem[]
  movimentos MovimentoEstoque[]

  @@index([empresaId, status])
  @@index([empresaId, localId])
  @@map("documentos_entrada")
}

model DocumentoEntradaItem {
  id                   String            @id @default(uuid())
  empresaId            String            @map("empresa_id")
  documentoId          String            @map("documento_id")
  ordem                Int               @default(0)
  descricaoOriginal    String            @map("descricao_original")
  descricaoNormalizada String            @map("descricao_normalizada")
  quantidade           Decimal           @db.Decimal(14, 4)
  unidade              String?
  valorUnitario        Decimal?          @map("valor_unitario") @db.Decimal(14, 4)
  valorTotal           Decimal?          @map("valor_total") @db.Decimal(14, 2)
  ncm                  String?
  ean                  String?
  insumoId             String?           @map("insumo_id")
  status               StatusItemEntrada @default(PENDENTE)
  tipoInsumo           TipoInsumo?       @map("tipo_insumo")
  candidatos           Json?

  documento DocumentoEntrada @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  insumo    CatalogoInsumo?  @relation(fields: [insumoId], references: [id])

  @@index([documentoId])
  @@index([empresaId])
  @@map("documentos_entrada_itens")
}

model SaldoEstoque {
  id         String   @id @default(uuid())
  empresaId  String   @map("empresa_id")
  localId    String   @map("local_id")
  insumoId   String   @map("insumo_id")
  quantidade Decimal  @default(0) @db.Decimal(14, 4)
  updatedAt  DateTime @updatedAt @map("updated_at")

  local   LocalEstoque   @relation(fields: [localId], references: [id])
  insumo  CatalogoInsumo @relation(fields: [insumoId], references: [id])
  empresa Empresa        @relation(fields: [empresaId], references: [id])

  @@unique([localId, insumoId])
  @@index([empresaId, localId])
  @@map("saldos_estoque")
}

model MovimentoEstoque {
  id              String               @id @default(uuid())
  empresaId       String               @map("empresa_id")
  tipo            TipoMovimentoEstoque
  insumoId        String               @map("insumo_id")
  localOrigemId   String?              @map("local_origem_id")
  localDestinoId  String?              @map("local_destino_id")
  quantidade      Decimal              @db.Decimal(14, 4)
  documentoId     String?              @map("documento_id")
  usuarioId       String               @map("usuario_id")
  motivo          String?
  retiradoPor     String?              @map("retirado_por")
  funcionarioId   String?              @map("funcionario_id")
  dataRecebimento DateTime?            @map("data_recebimento")
  validadeEpi     DateTime?            @map("validade_epi") @db.Date
  ca              String?
  assinatura      String?              @db.Text
  createdAt       DateTime             @default(now()) @map("created_at")

  empresa      Empresa           @relation(fields: [empresaId], references: [id])
  insumo       CatalogoInsumo    @relation(fields: [insumoId], references: [id])
  localOrigem  LocalEstoque?     @relation("MovimentoOrigem", fields: [localOrigemId], references: [id])
  localDestino LocalEstoque?     @relation("MovimentoDestino", fields: [localDestinoId], references: [id])
  documento    DocumentoEntrada? @relation(fields: [documentoId], references: [id])
  usuario      Usuario           @relation(fields: [usuarioId], references: [id])
  funcionario  Funcionario?      @relation(fields: [funcionarioId], references: [id])

  @@index([empresaId, createdAt])
  @@index([documentoId])
  @@index([funcionarioId])
  @@map("movimentos_estoque")
}

