model Funcionario {
  id             String             @id @default(uuid())
  empresaId      String             @map("empresa_id")
  obraId         String?            @map("obra_id")
  nome           String
  funcao         String
  cpf            String?            @db.Text
  cpfHash        String?            @map("cpf_hash")
  rg             String?
  rgOrgao        String?            @map("rg_orgao")
  rgUf           String?            @map("rg_uf")
  dataNascimento DateTime?          @map("data_nascimento") @db.Date
  sexo           Sexo?
  estadoCivil    EstadoCivil?       @map("estado_civil")
  nacionalidade  String?
  naturalidade   String?
  nomeMae        String?            @map("nome_mae")
  nomePai        String?            @map("nome_pai")
  pis            String?            @db.Text
  pisHash        String?            @map("pis_hash")
  ctpsNumero     String?            @map("ctps_numero")
  ctpsSerie      String?            @map("ctps_serie")
  ctpsUf         String?            @map("ctps_uf")
  escolaridade   Escolaridade?
  telefone       String?
  email          String?
  cep            String?
  logradouro     String?
  numero         String?
  complemento    String?
  bairro         String?
  cidade         String?
  uf             String?
  cbo            String?
  matricula      String?
  dataAdmissao   DateTime?          @map("data_admissao") @db.Date
  tipoContrato   TipoContrato?      @map("tipo_contrato")
  salario        Decimal?           @db.Decimal(14, 2)
  jornada        String?
  banco          String?
  agencia        String?
  conta          String?
  tipoConta      TipoContaBancaria? @map("tipo_conta")
  pix            String?
  ativo          Boolean            @default(true)
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  deletedAt      DateTime?          @map("deleted_at")

  empresa      Empresa                  @relation(fields: [empresaId], references: [id])
  obra         Obra?                    @relation(fields: [obraId], references: [id])
  movimentos   MovimentoEstoque[]
  treinamentos TreinamentoFuncionario[]
  exames       ExameFuncionario[]

  @@unique([empresaId, cpfHash])
  @@unique([empresaId, pisHash])
  @@index([empresaId, obraId])
  @@map("funcionarios")
}

model TreinamentoFuncionario {
  id             String          @id @default(uuid())
  empresaId      String          @map("empresa_id")
  obraId         String?         @map("obra_id")
  funcionarioId  String          @map("funcionario_id")
  tipo           TipoTreinamento
  nome           String
  dataRealizacao DateTime        @map("data_realizacao") @db.Date
  cargaHoraria   Decimal?        @map("carga_horaria") @db.Decimal(6, 2)
  validade       DateTime        @db.Date
  instrutor       String?
  observacao      String?
  assinatura      String?         @db.Text
  certificadoUrl  String?         @map("certificado_url")
  certificadoNome String?         @map("certificado_nome")
  certificadoMime String?         @map("certificado_mime")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  deletedAt       DateTime?       @map("deleted_at")

  empresa     Empresa     @relation(fields: [empresaId], references: [id])
  obra        Obra?       @relation(fields: [obraId], references: [id])
  funcionario Funcionario @relation(fields: [funcionarioId], references: [id])

  @@index([empresaId, obraId, validade])
  @@index([funcionarioId, tipo])
