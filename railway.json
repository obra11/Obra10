{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": ["obra10-backend/**", "Dockerfile"]
  },
  "deploy": {
    "startCommand": "npx prisma migrate deploy && node dist/src/main",
    "restartPolicyType": "ON_FAILURE"
  }
}
