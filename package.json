{
  "name": "obra10-workspace",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:backend": "npm --prefix obra10-backend run start:dev",
    "dev:frontend": "npm --prefix obra10-frontend run dev",
    "build:frontend": "npm --prefix obra10-frontend run build",
    "build:backend": "npm --prefix obra10-backend run build",
    "sync:assets": "node sync-assets.js",
    "db:sync": "node obra10-backend/scratch/sync_db_prod_to_local.js",
    "build": "npm run check:uploads && npm run build:frontend && npm run sync:assets && npm run build:backend",
    "check:uploads": "node scripts/check-no-tracked-uploads.cjs",
    "prepush": "npm run check:uploads"
  },
  "dependencies": {
    "localtunnel": "^2.0.2"
  }
}
